spring.application.name=Server

spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:${POSTGRES_PORT:5432}}/${DB_NAME:${POSTGRES_DB:lamtube}}
spring.datasource.username=${DB_USERNAME:${POSTGRES_USER:postgres}}
spring.datasource.password=${DB_PASSWORD:${POSTGRES_PASSWORD:postgres}}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Liquibase
spring.liquibase.enabled=true
spring.liquibase.change-log=classpath:db/changelog/db.changelog-master.yaml

# JWT / Auth
app.jwt.secret-key=${APP_JWT_SECRET_KEY:TaqlmGv1iEDMRiFp/pHuID1+T84IABfuA0xXh4GhiUI=}
app.jwt.access-expiration-seconds=${APP_JWT_ACCESS_EXPIRATION_SECONDS:900}
app.jwt.refresh-expiration-seconds=${APP_JWT_REFRESH_EXPIRATION_SECONDS:2592000}
app.auth.refresh-token-ttl-days=${APP_AUTH_REFRESH_TOKEN_TTL_DAYS:30}
app.auth.cookie.refresh-token-name=${APP_AUTH_COOKIE_REFRESH_TOKEN_NAME:refresh_token}
app.auth.cookie.refresh-token-max-age-seconds=${APP_AUTH_COOKIE_REFRESH_TOKEN_MAX_AGE_SECONDS:2592000}
app.auth.cookie.secure=${APP_AUTH_COOKIE_SECURE:false}
app.auth.cookie.same-site=${APP_AUTH_COOKIE_SAME_SITE:Lax}
app.auth.cookie.path=${APP_AUTH_COOKIE_PATH:/api}
app.auth.password-reset.otp-ttl-seconds=${APP_AUTH_PASSWORD_RESET_OTP_TTL_SECONDS:300}
app.auth.password-reset.reset-token-ttl-seconds=${APP_AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS:600}

# CORS
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:5173}
app.cors.allowed-origin-patterns=${APP_CORS_ALLOWED_ORIGIN_PATTERNS:}

# Cloudinary Configuration
cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:}
cloudinary.api-key=${CLOUDINARY_API_KEY:}
cloudinary.api-secret=${CLOUDINARY_API_SECRET:}

# RustFS S3-compatible credentials
rustfs.access-key=${RUSTFS_ACCESS_KEY:rustfsadmin}
rustfs.secret-key=${RUSTFS_SECRET_KEY:rustfsadmin}
rustfs.bucket-name=${RUSTFS_BUCKET_NAME:lamtube}
rustfs.internal-url=${RUSTFS_INTERNAL_URL:http://localhost:9000}
rustfs.public-url-prefix=${RUSTFS_PUBLIC_URL_PREFIX:http://localhost:9000}

spring.servlet.multipart.max-file-size=500MB
spring.servlet.multipart.max-request-size=500MB

# REDIS CACHE
spring.cache.type=redis
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.timeout=2000


# MAIL CONFIG (GMAIL SMTP)
spring.mail.host=${MAIL_HOST:smtp.gmail.com}
spring.mail.port=${MAIL_PORT:587}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=${MAIL_SMTP_AUTH:true}
spring.mail.properties.mail.smtp.starttls.enable=${MAIL_SMTP_STARTTLS_ENABLE:true}
spring.mail.properties.mail.smtp.starttls.required=${MAIL_SMTP_STARTTLS_REQUIRED:true}
spring.mail.properties.mail.smtp.connectiontimeout=${MAIL_SMTP_CONNECTION_TIMEOUT:5000}
spring.mail.properties.mail.smtp.timeout=${MAIL_SMTP_TIMEOUT:5000}
spring.mail.properties.mail.smtp.writetimeout=${MAIL_SMTP_WRITE_TIMEOUT:5000}
